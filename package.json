{
  "name": "kimi-code-desktop",
  "version": "0.2.1",
  "private": true,
  "description": "面向 Windows 的非官方 Kimi Code 桌面客户端，直接使用系统已安装的 CLI。",
  "type": "module",
  "main": "dist/main/main.js",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder --win nsis",
    "build:dir": "electron-vite build && electron-builder --win dir",
    "typecheck": "tsc -b tsconfig.node.json tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm typecheck"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "cmdk": "1.1.1",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "29.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "license": "MIT",
  "author": "MarkWu",
  "homepage": "https://github.com/wjt0321/kimi-code-desktop#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/wjt0321/kimi-code-desktop.git"
  }
}
